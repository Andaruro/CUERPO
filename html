<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Partes del cuerpo</title>

<style>

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:linear-gradient(#9be7ff,#ffffff);
    text-align:center;
}

h1{
    color:#1565C0;
    font-size:50px;
}

#imagen{

    font-size:180px;
    margin-top:15px;

}

#palabra{

    font-size:65px;
    font-weight:bold;
    letter-spacing:10px;
    margin:25px;

}

#opciones button{

    width:120px;
    height:120px;
    margin:15px;
    border:none;
    border-radius:20px;
    font-size:60px;
    cursor:pointer;
    background:#FFD54F;
    transition:.3s;

}

#opciones button:hover{

transform:scale(1.08);

}

#mensaje{

font-size:45px;
margin-top:25px;
height:60px;
font-weight:bold;

}

#estrellas{

font-size:40px;
margin-top:15px;

}

#reiniciar{

display:none;
padding:15px 35px;
font-size:28px;
border:none;
background:#4CAF50;
color:white;
border-radius:15px;
cursor:pointer;
margin-top:20px;

}

</style>

</head>

<body>

<h1>⭐ Completa la palabra ⭐</h1>

<div id="imagen"></div>

<div id="palabra"></div>

<div id="opciones"></div>

<div id="mensaje"></div>

<div id="estrellas"></div>

<button id="reiniciar" onclick="reiniciar()">
Jugar otra vez
</button>

<script>

const juegos=[

{
emoji:"✋",
nombre:"MANOS",
mostrar:"M _ N O S",
correcta:"A",
opciones:["A","E","I"]
},

{
emoji:"💪",
nombre:"BRAZO",
mostrar:"B R A _ O",
correcta:"Z",
opciones:["Z","P","S"]
},

{
emoji:"👀",
nombre:"OJOS",
mostrar:"O J _ S",
correcta:"O",
opciones:["A","O","E"]
},

{
emoji:"👃",
nombre:"NARIZ",
mostrar:"N A _ I Z",
correcta:"R",
opciones:["L","R","T"]
},

{
emoji:"👄",
nombre:"BOCA",
mostrar:"B O _ A",
correcta:"C",
opciones:["G","C","P"]
},

{
emoji:"🦵",
nombre:"PIERNA",
mostrar:"P I E _ N A",
correcta:"R",
opciones:["R","L","M"]
},

{
emoji:"🦶",
nombre:"PIE",
mostrar:"P _ E",
correcta:"I",
opciones:["A","I","O"]
},

{
emoji:"🙂",
nombre:"CABEZA",
mostrar:"C A B E _ A",
correcta:"Z",
opciones:["S","Z","R"]
}

];

let actual=0;
let estrellas=0;

const imagen=document.getElementById("imagen");
const palabra=document.getElementById("palabra");
const opciones=document.getElementById("opciones");
const mensaje=document.getElementById("mensaje");
const txtEstrellas=document.getElementById("estrellas");

function cargar(){

mensaje.innerHTML="";

let juego=juegos[actual];

imagen.innerHTML=juego.emoji;

palabra.innerHTML=juego.mostrar;

opciones.innerHTML="";

juego.opciones.sort(()=>Math.random()-0.5);

juego.opciones.forEach(letra=>{

let b=document.createElement("button");

b.innerHTML=letra;

b.onclick=()=>respuesta(letra);

opciones.appendChild(b);

});

txtEstrellas.innerHTML="⭐ ".repeat(estrellas);

}

function respuesta(letra){

if(letra==juegos[actual].correcta){

mensaje.style.color="green";
mensaje.innerHTML="🎉 ¡Muy bien!";

estrellas++;

setTimeout(()=>{

actual++;

if(actual<juegos.length){

cargar();

}else{

fin();

}

},900);

}else{

mensaje.style.color="red";
mensaje.innerHTML="❌ Intenta otra vez";

}

}

function fin(){

imagen.innerHTML="🏆";

palabra.innerHTML="¡Excelente!";

opciones.innerHTML="";

mensaje.style.color="#1565C0";
mensaje.innerHTML="Aprendiste las partes del cuerpo.";

txtEstrellas.innerHTML="⭐".repeat(estrellas);

document.getElementById("reiniciar").style.display="inline-block";

}

function reiniciar(){

actual=0;

estrellas=0;

document.getElementById("reiniciar").style.display="none";

cargar();

}

cargar();

</script>

</body>
</html>


         

       